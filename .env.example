# Copy this file to ".env" and fill in your real values.
# Without eBay keys the lookup and Rarities tabs report that the keys are missing.
# Without Pushover keys the digest prints to the journal instead of pushing.

# --- eBay Browse API (developer.ebay.com -> Application Keysets -> Production) ---
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# --- Pushover (pushover.net) ---
PUSHOVER_USER_KEY=
PUSHOVER_API_TOKEN=
